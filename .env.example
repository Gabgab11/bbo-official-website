# Copy to .env for local development. Never commit .env.
# These are the PUBLIC (publishable) Supabase values. Row Level Security on the
# database only allows the website to insert form submissions; it cannot read them.
# Never put a Supabase service_role / secret key here.
VITE_SUPABASE_URL=https://yijgkqzdnjpewtdsyach.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Public address of the site, used for canonical and Open Graph tags.
VITE_SITE_URL=https://gabgab11.github.io/bbo-official-website/
